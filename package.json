{
  "name": "@aurigax-ai/ostia-ghostty",
  "version": "0.0.0",
  "description": "Ghostty's terminal engine (libghostty-vt) in the browser: WebAssembly build, an xterm.js-shaped API and a canvas renderer. A hard fork of coder/ghostty-web.",
  "type": "module",
  "main": "./dist/ostia-ghostty.umd.cjs",
  "module": "./dist/ostia-ghostty.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ostia-ghostty.js",
      "require": "./dist/ostia-ghostty.umd.cjs"
    },
    "./ghostty-vt.wasm": "./ghostty-vt.wasm"
  },
  "files": [
    "dist",
    "ghostty-vt.wasm",
    "README.md"
  ],
  "keywords": [
    "terminal",
    "terminal-emulator",
    "ghostty",
    "web",
    "xterm",
    "vt100",
    "wasm",
    "webassembly",
    "ansi",
    "tty"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aurigax-ai/ostia-ghostty.git"
  },
  "bugs": "https://github.com/aurigax-ai/ostia-ghostty/issues",
  "homepage": "https://github.com/aurigax-ai/ostia-ghostty#readme",
  "license": "MIT",
  "author": "AurigaX",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --port 8000",
    "build": "pnpm clean && pnpm build:wasm && pnpm build:lib && cp ghostty-vt.wasm dist/",
    "build:wasm": "./scripts/build-wasm.sh",
    "build:lib": "vite build",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fmt": "prettier --check .",
    "fmt:fix": "prettier --write --cache .",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.19.1",
    "happy-dom": "^15.11.7",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^4.5.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@11.10.0"
}
